  },
  "devDependencies": {
    "@paypal/react-paypal-js": "^10.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
