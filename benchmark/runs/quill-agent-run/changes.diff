+// --- Payment outcomes shared by Stripe and PayPal, so the two can never drift apart. Both are idempotent. ---
+
+/** Marks a pending purchase paid and grants its credits. Does nothing if it is not pending. */
+function fulfilPayment(purchaseId: string, patch: Partial<Purchase>): boolean {
+  const purchase = getPurchase(purchaseId);
+  if (!purchase || purchase.status !== "pending") return false;
