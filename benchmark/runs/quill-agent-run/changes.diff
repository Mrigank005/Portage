+/** Refunds a PayPal purchase's capture: fully, or partly with `amount` in cents (a positive whole number). */
+async function refundPayPalPurchase(purchase: Purchase, amount: unknown, res: express.Response): Promise<void> {
+  if (!purchase.paypalCaptureId) {
+    res.status(404).json({ error: "Purchase not found or not paid" });
+    return;
+  }
+  // Check a partial amount before converting it: an invalid amount must never turn into a full refund.
+  let cents: number | undefined;
+  if (amount !== undefined && amount !== null && amount !== "") {
+    cents = Number(amount);
+    if (!Number.isSafeInteger(cents) || cents <= 0) {
+      res.status(400).json({ error: "Refund amount must be a positive whole number of cents" });
+      return;
+    }
+  }
+  try {
+    const { result } = await paymentsApi().refundCapturedPayment({
+      captureId: purchase.paypalCaptureId,
+      paypalRequestId: paypalRequestId(),
+      prefer: "return=representation",
+      body: cents === undefined ? undefined : { amount: toPayPalMoney(cents, purchase.currency) },
+    });
+    // The refund carries the running refunded total; recording it here and in the webhook counts it once.
+    const total = result.sellerPayableBreakdown?.totalRefundedAmount;
+    if (total) recordPayPalRefund(getPurchase(purchase.id) ?? purchase, fromPayPalMoney(total));
+    res.json({ refunded: result.amount ? fromPayPalMoney(result.amount) : (cents ?? purchase.amount - purchase.refundedAmount) });
+  } catch (err) {
+    console.error(`[quill] ${purchase.id}: could not refund PayPal capture: ${describePayPalError(err)}`);
+    res.status(400).json({ error: "PayPal could not refund this payment" });
+  }
+}
