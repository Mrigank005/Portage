diff --git a/src/paypal-money.ts b/src/paypal-money.ts
new file mode 100644
index 0000000..2b5135b
--- /dev/null
+++ b/src/paypal-money.ts
@@ -0,0 +1,72 @@
+// Portage reference: money conversion between the app's Stripe-style amounts and PayPal amounts.
+//
+// Stripe amounts are integers in the currency's minor unit ("2400" = 24.00 USD; "2400" = 2400 JPY).
+// PayPal amounts are decimal strings with PayPal's own number of decimals ("24.00", "2400").
+// They disagree for HUF and TWD (two decimals on Stripe, none on PayPal), so this refuses instead of rounding.
+// Self-contained on purpose: copy it into the app as it is. Portage's tests check it against Portage's own helper.
+
+export interface PayPalMoney {
+  currencyCode: string;
+  value: string;
+}
+
+/** Decimal places PayPal accepts, per currency it supports (developer.paypal.com/api/rest/reference/currency-codes). */
+const PAYPAL_DECIMALS: Record<string, number> = {
+  AUD: 2, BRL: 2, CAD: 2, CNY: 2, CZK: 2, DKK: 2, EUR: 2, HKD: 2, HUF: 0, ILS: 2, JPY: 0, MYR: 2, MXN: 2,
+  TWD: 0, NZD: 2, NOK: 2, PHP: 2, PLN: 2, GBP: 2, RUB: 2, SGD: 2, SEK: 2, CHF: 2, THB: 2, USD: 2,
+};
+/** Stripe's zero- and three-decimal currencies (docs.stripe.com/currencies); everything else is two. */
+const STRIPE_ZERO = new Set(["BIF", "CLP", "DJF", "GNF", "JPY", "KMF", "KRW", "MGA", "PYG", "RWF", "VND", "VUV", "XAF", "XOF", "XPF"]);
+const STRIPE_THREE = new Set(["BHD", "JOD", "KWD", "OMR", "TND"]);
+
+const code = (currency: string): string => {
+  if (!/^[A-Za-z]{3}$/.test(currency)) throw new Error(`"${currency}" is not a currency code`);
+  return currency.toUpperCase();
+};
+const stripeDecimals = (c: string) => (STRIPE_ZERO.has(c) ? 0 : STRIPE_THREE.has(c) ? 3 : 2);
+
+export function paypalSupportsCurrency(currency: string): boolean {
+  return code(currency) in PAYPAL_DECIMALS;
+}
+
+/** 2400, "usd" → { currencyCode: "USD", value: "24.00" }. Throws for amounts PayPal can't represent exactly. */
+export function toPayPalMoney(minorUnits: number, currency: string): PayPalMoney {
+  if (!Number.isSafeInteger(minorUnits) || minorUnits < 0) throw new Error(`Amount must be a whole number of minor units, got ${minorUnits}`);
+  const c = code(currency);
+  const pp = PAYPAL_DECIMALS[c];
+  if (pp === undefined) throw new Error(`PayPal does not accept payments in ${c}`);
+  const st = stripeDecimals(c);
+  let units = BigInt(minorUnits);
+  if (st > pp) {
+    const factor = 10n ** BigInt(st - pp);
+    if (units % factor !== 0n) throw new Error(`${minorUnits} (${c} minor units) has no exact PayPal amount: PayPal takes ${pp} decimals for ${c}`);
+    units /= factor;
+  } else if (st < pp) {
+    units *= 10n ** BigInt(pp - st);
+  }
+  return { currencyCode: c, value: format(units, pp) };
+}
+
+/**
+ * { currencyCode: "USD", value: "24.00" } → 2400. Also accepts the snake_case shape PayPal's webhooks and REST
+ * responses use ({ currency_code, value }), so SDK results and webhook payloads go through the same helper.
+ */
+export function fromPayPalMoney(money: { currencyCode?: string; currency_code?: string; value?: string }): number {
+  const c = code(money.currencyCode ?? money.currency_code ?? "");
+  const pp = PAYPAL_DECIMALS[c];
+  if (pp === undefined) throw new Error(`PayPal does not accept payments in ${c}`);
+  const m = /^(\d+)(?:\.(\d+))?$/.exec(money.value ?? "");
+  if (!m || (m[2] ?? "").length > pp) throw new Error(`"${money.value}" is not a valid ${c} amount`);
+  const st = stripeDecimals(c);
+  const units = BigInt(m[1] + (m[2] ?? "").padEnd(pp, "0"));
+  const minor = st >= pp ? units * 10n ** BigInt(st - pp) : units / 10n ** BigInt(pp - st);
+  if (st < pp && units % 10n ** BigInt(pp - st) !== 0n) throw new Error(`"${money.value}" ${c} has no exact amount in minor units`);
+  if (minor > BigInt(Number.MAX_SAFE_INTEGER)) throw new Error(`"${money.value}" is too large`);
+  return Number(minor);
+}
+
+function format(units: bigint, decimals: number): string {
+  if (decimals === 0) return units.toString();
+  const s = units.toString().padStart(decimals + 1, "0");
+  return `${s.slice(0, -decimals)}.${s.slice(-decimals)}`;
+}
diff --git a/src/paypal-webhook.ts b/src/paypal-webhook.ts
new file mode 100644
index 0000000..b168710
--- /dev/null
+++ b/src/paypal-webhook.ts
@@ -0,0 +1,128 @@
+// Portage reference: verify a PayPal webhook before trusting it.
+//
+// The PayPal Server SDK has no webhook methods (confirmed through ContextMatic), so this calls PayPal's REST API
+// directly: POST /v1/notifications/verify-webhook-signature, with an OAuth token for the same credentials.
+// The event is passed to PayPal exactly as received (the raw body text), never re-serialised, because PayPal checks
+// the signature over the original bytes.
+import { randomUUID } from "node:crypto";
+
+export interface PayPalWebhookEvent {
+  id: string;
+  event_type: string;
+  resource_type?: string;
+  resource: Record<string, unknown> & {
+    id?: string;
+    status?: string;
+    custom_id?: string;
+    amount?: { currency_code?: string; value?: string };
+    supplementary_data?: { related_ids?: { order_id?: string } };
+    /** On refund events: total_refunded_amount is the running refunded total for the capture. */
+    seller_payable_breakdown?: { total_refunded_amount?: { currency_code?: string; value?: string } };
+    links?: { href: string; rel: string; method?: string }[];
+  };
+  create_time?: string;
+}
+
+export type WebhookVerification = { verified: true; event: PayPalWebhookEvent } | { verified: false; reason: string };
+
+const HEADERS = ["paypal-transmission-id", "paypal-transmission-time", "paypal-transmission-sig", "paypal-cert-url", "paypal-auth-algo"] as const;
+
+/** PayPal's REST base URL for the configured environment. PAYPAL_API_BASE overrides it (for tests only). */
+export function paypalApiBase(): string {
+  if (process.env.PAYPAL_API_BASE) return process.env.PAYPAL_API_BASE.replace(/\/$/, "");
+  return process.env.PAYPAL_ENVIRONMENT === "live" ? "https://api-m.paypal.com" : "https://api-m.sandbox.paypal.com";
+}
+
+/**
+ * fetch with up to two retries, with backoff, for dropped connections, 429 and 5xx. Safe for these calls: getting a
+ * token and verifying a signature change nothing at PayPal.
+ */
+async function fetchWithRetry(url: string, init: RequestInit, attempts = 3): Promise<Response> {
+  for (let i = 0; ; i++) {
+    try {
+      const res = await fetch(url, init);
+      if ((res.status === 429 || res.status >= 500) && i < attempts - 1) {
+        await new Promise((r) => setTimeout(r, 500 * 2 ** i));
+        continue;
+      }
+      return res;
+    } catch (err) {
+      if (i >= attempts - 1) throw err;
+      await new Promise((r) => setTimeout(r, 500 * 2 ** i));
+    }
+  }
+}
+
+let cached: { token: string; expiresAt: number } | undefined;
+
+/** A client-credentials access token, cached until a minute before it expires (PayPal sends expires_in). */
+export async function paypalAccessToken(): Promise<string> {
+  if (cached && Date.now() < cached.expiresAt) return cached.token;
+  const id = process.env.PAYPAL_CLIENT_ID;
+  const secret = process.env.PAYPAL_CLIENT_SECRET;
+  if (!id || !secret) throw new Error("PayPal is not configured: set PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET");
+  const res = await fetchWithRetry(`${paypalApiBase()}/v1/oauth2/token`, {
+    method: "POST",
+    headers: { Authorization: `Basic ${Buffer.from(`${id}:${secret}`).toString("base64")}`, "Content-Type": "application/x-www-form-urlencoded" },
+    body: "grant_type=client_credentials",
+  });
+  if (!res.ok) throw new Error(`PayPal OAuth failed with HTTP ${res.status}`);
+  const data = (await res.json()) as { access_token: string; expires_in: number };
+  cached = { token: data.access_token, expiresAt: Date.now() + Math.max(0, data.expires_in - 60) * 1000 };
+  return data.access_token;
+}
+
+function header(headers: Headers | Record<string, string | string[] | undefined>, name: string): string | undefined {
+  if (typeof (headers as Headers).get === "function") return (headers as Headers).get(name) ?? undefined;
+  const record = headers as Record<string, string | string[] | undefined>;
+  const key = Object.keys(record).find((k) => k.toLowerCase() === name);
+  const v = key ? record[key] : undefined;
+  return Array.isArray(v) ? v[0] : v;
+}
+
+/**
+ * Verifies a webhook delivery with PayPal.
+ * @param headers the request headers (a Fetch `Headers`, or Node/Express `req.headers`)
+ * @param rawBody the request body exactly as received, as text
+ */
+export async function verifyPayPalWebhook(headers: Headers | Record<string, string | string[] | undefined>, rawBody: string): Promise<WebhookVerification> {
+  const webhookId = process.env.PAYPAL_WEBHOOK_ID;
+  if (!webhookId) return { verified: false, reason: "PAYPAL_WEBHOOK_ID is not set" };
+  const values = HEADERS.map((h) => header(headers, h));
+  if (values.some((v) => !v)) return { verified: false, reason: "missing PayPal transmission headers" };
+
+  let event: PayPalWebhookEvent;
+  try {
+    event = JSON.parse(rawBody) as PayPalWebhookEvent;
+  } catch {
+    return { verified: false, reason: "body is not JSON" };
+  }
+  if (!event || typeof event.event_type !== "string") return { verified: false, reason: "body is not a PayPal event" };
+
+  const [transmissionId, transmissionTime, transmissionSig, certUrl, authAlgo] = values as string[];
+  // Splice the raw body in as the event so PayPal sees the original bytes.
+  const body =
+    `{"auth_algo":${JSON.stringify(authAlgo)},"cert_url":${JSON.stringify(certUrl)},"transmission_id":${JSON.stringify(transmissionId)},` +
+    `"transmission_sig":${JSON.stringify(transmissionSig)},"transmission_time":${JSON.stringify(transmissionTime)},` +
+    `"webhook_id":${JSON.stringify(webhookId)},"webhook_event":${rawBody}}`;
+
+  const res = await fetchWithRetry(`${paypalApiBase()}/v1/notifications/verify-webhook-signature`, {
+    method: "POST",
+    headers: { Authorization: `Bearer ${await paypalAccessToken()}`, "Content-Type": "application/json", "PayPal-Request-Id": randomUUID() },
+    body,
+  });
+  if (!res.ok) {
+    // Say which field PayPal rejected (for example a malformed webhook_id), without echoing any values.
+    const err = (await res.json().catch(() => ({}))) as { name?: string; details?: { field?: string; issue?: string }[] };
+    const d = err.details?.[0];
+    return { verified: false, reason: `verification call failed with HTTP ${res.status}${d ? `: ${d.field ?? ""} ${d.issue ?? ""}`.trimEnd() : err.name ? `: ${err.name}` : ""}` };
+  }
+  const result = (await res.json()) as { verification_status?: string };
+  return result.verification_status === "SUCCESS" ? { verified: true, event } : { verified: false, reason: `verification_status ${result.verification_status ?? "missing"}` };
+}
+
+/** For PAYMENT.CAPTURE.REFUNDED: the refund's resource links "up" to the capture it refunds. */
+export function capturedPaymentIdOfRefund(event: PayPalWebhookEvent): string | undefined {
+  const up = event.resource.links?.find((l) => l.rel === "up" && /\/captures\//.test(l.href));
+  return up ? up.href.split("/captures/")[1]?.split(/[/?]/)[0] : undefined;
+}
diff --git a/src/paypal.ts b/src/paypal.ts
new file mode 100644
index 0000000..3334533
--- /dev/null
+++ b/src/paypal.ts
@@ -0,0 +1,63 @@
+// Portage reference: one shared PayPal Server SDK client for the app.
+//
+// Every SDK name here was confirmed through ContextMatic (APIMatic Context Plugin): fetch_api paypal,
+// endpoint_search createOrder / captureOrder / refundCapturedPayment / getCapturedPayment, model_search Money.
+// Typechecked against @paypal/paypal-server-sdk 2.x. Adapt the import paths and style to the app; keep the behaviour.
+import { randomUUID } from "node:crypto";
+import { ApiError, Client, CustomError, Environment, OrdersController, PaymentsController } from "@paypal/paypal-server-sdk";
+
+/** "sandbox" unless PAYPAL_ENVIRONMENT is explicitly "live". */
+export const paypalEnvironment: "sandbox" | "live" = process.env.PAYPAL_ENVIRONMENT === "live" ? "live" : "sandbox";
+
+let client: Client | undefined;
+
+/**
+ * The SDK client, created on first use so that importing this module during a build (when PayPal settings may be
+ * absent) doesn't throw. The SDK fetches and caches its OAuth token itself.
+ */
+export function paypalClient(): Client {
+  if (client) return client;
+  const oAuthClientId = process.env.PAYPAL_CLIENT_ID;
+  const oAuthClientSecret = process.env.PAYPAL_CLIENT_SECRET;
+  if (!oAuthClientId || !oAuthClientSecret) {
+    throw new Error("PayPal is not configured: set PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET");
+  }
+  client = new Client({
+    clientCredentialsAuthCredentials: { oAuthClientId, oAuthClientSecret },
+    environment: paypalEnvironment === "live" ? Environment.Production : Environment.Sandbox,
+    timeout: 15_000,
+    httpClientOptions: {
+      // Retry dropped connections, 429s and 5xx with backoff (PayPal recommends it). POST is included on purpose:
+      // every POST here sends a PayPal-Request-Id, so a retried POST returns the original result instead of
+      // charging twice. The SDK's defaults are no retries, and never for POST.
+      retryConfig: {
+        maxNumberOfRetries: 2,
+        retryOnTimeout: true, // the SDK treats network errors (ECONNRESET, ...) as timeouts
+        maximumRetryWaitTime: 10,
+        httpMethodsToRetry: ["GET", "PUT", "POST", "PATCH"],
+      },
+    },
+    // No `logging` option on purpose: with one, the SDK logs every request and response, which can include payer
+    // details. Log failures yourself with describePayPalError.
+  });
+  return client;
+}
+
+export const ordersApi = (): OrdersController => new OrdersController(paypalClient());
+export const paymentsApi = (): PaymentsController => new PaymentsController(paypalClient());
+
+/** A fresh PayPal-Request-Id. Send one with every POST; reuse the same value when retrying the same request. */
+export const paypalRequestId = (): string => randomUUID();
+
+/** A log-safe description of a PayPal error, including PayPal's debug_id, which PayPal support asks for. */
+export function describePayPalError(err: unknown): string {
+  if (err instanceof ApiError) {
+    // The SDK keeps PayPal's error body as sent (snake_case), and PayPal also returns the id as a header.
+    const r = (err instanceof CustomError ? err.result : undefined) as { name?: string; message?: string; debug_id?: string; details?: { issue?: string }[] } | undefined;
+    const debugId = r?.debug_id ?? err.headers?.["paypal-debug-id"] ?? (typeof err.body === "string" ? /"debug_id"\s*:\s*"([^"]+)"/.exec(err.body)?.[1] : undefined);
+    const issue = r?.details?.[0]?.issue;
+    const detail = [r?.name, issue ?? r?.message, debugId ? `debug_id ${debugId}` : ""].filter(Boolean).join(" · ");
+    return `PayPal API error ${err.statusCode}${detail ? `: ${detail}` : ""}`;
+  }
+  return err instanceof Error ? err.message : String(err);
+}
