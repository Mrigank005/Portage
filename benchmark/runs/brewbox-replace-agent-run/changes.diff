+// The product catalog. It used to be read from Stripe on every request; it is now the copy that Portage's
+// migrate_catalog wrote to portage.catalog.json (Stripe product → PayPal catalog product, prices in minor units).
+import catalog from "@/portage.catalog.json";
+
+export interface CatalogProduct {
+  id: string;
+  paypalProductId: string;
+  name: string;
+  description: string;
+  price: { id: string; unitAmount: number; currency: string };
+}
+
+export const products: CatalogProduct[] = catalog.products.flatMap((p) => {
+  const price = p.prices.find((pr) => pr.isDefault) ?? p.prices[0];
+  if (!price) return [];
+  return [
+    {
+      id: p.stripeProductId,
+      paypalProductId: p.paypalProductId,
+      name: p.name,
+      description: p.description,
+      price: { id: price.stripePriceId, unitAmount: price.unitAmount, currency: price.currency },
+    },
+  ];
+});
+
+/** Finds a product by its price ID, the value the shop's forms send. */
+export function findByPriceId(priceId: string): CatalogProduct | undefined {
+  return products.find((p) => p.price.id === priceId);
+}
