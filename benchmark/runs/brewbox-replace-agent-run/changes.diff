new file mode 100644
index 0000000..011aa4b
--- /dev/null
+++ b/lib/paypal-webhook.ts
@@ -0,0 +1,121 @@
+// Verify a PayPal webhook before trusting it.
+//
+// The PayPal Server SDK has no webhook methods, so this calls PayPal's REST API directly:
+// POST /v1/notifications/verify-webhook-signature, with an OAuth token for the same credentials.
+// The event is passed to PayPal exactly as received (the raw body text), never re-serialised, because PayPal checks
+// the signature over the original bytes.
+import { randomUUID } from "node:crypto";
+
+export interface PayPalWebhookEvent {
+  id: string;
+  event_type: string;
+  resource_type?: string;
+  resource: Record<string, unknown> & {
+    id?: string;
+    status?: string;
+    custom_id?: string;
+    amount?: { currency_code?: string; value?: string };
+    supplementary_data?: { related_ids?: { order_id?: string } };
+    /** On refund events: total_refunded_amount is the running refunded total for the capture. */
+    seller_payable_breakdown?: { total_refunded_amount?: { currency_code?: string; value?: string } };
+    links?: { href: string; rel: string; method?: string }[];
+  };
+  create_time?: string;
+}
+
+export type WebhookVerification = { verified: true; event: PayPalWebhookEvent } | { verified: false; reason: string };
+
+const HEADERS = ["paypal-transmission-id", "paypal-transmission-time", "paypal-transmission-sig", "paypal-cert-url", "paypal-auth-algo"] as const;
+
+/** PayPal's REST base URL for the configured environment. PAYPAL_API_BASE overrides it (for tests only). */
+export function paypalApiBase(): string {
+  if (process.env.PAYPAL_API_BASE) return process.env.PAYPAL_API_BASE.replace(/\/$/, "");
+  return process.env.PAYPAL_ENVIRONMENT === "live" ? "https://api-m.paypal.com" : "https://api-m.sandbox.paypal.com";
+}
+
+/** fetch with up to two retries for dropped connections, 429 and 5xx. Safe here: these calls change nothing at PayPal. */
+async function fetchWithRetry(url: string, init: RequestInit, attempts = 3): Promise<Response> {
+  for (let i = 0; ; i++) {
+    try {
+      const res = await fetch(url, init);
+      if ((res.status === 429 || res.status >= 500) && i < attempts - 1) {
+        await new Promise((r) => setTimeout(r, 500 * 2 ** i));
+        continue;
+      }
+      return res;
+    } catch (err) {
+      if (i >= attempts - 1) throw err;
+      await new Promise((r) => setTimeout(r, 500 * 2 ** i));
+    }
+  }
+}
+
+let cached: { token: string; expiresAt: number } | undefined;
+
+/** A client-credentials access token, cached until a minute before it expires. */
+export async function paypalAccessToken(): Promise<string> {
+  if (cached && Date.now() < cached.expiresAt) return cached.token;
+  const id = process.env.PAYPAL_CLIENT_ID;
+  const secret = process.env.PAYPAL_CLIENT_SECRET;
+  if (!id || !secret) throw new Error("PayPal is not configured: set PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET");
+  const res = await fetchWithRetry(`${paypalApiBase()}/v1/oauth2/token`, {
+    method: "POST",
+    headers: { Authorization: `Basic ${Buffer.from(`${id}:${secret}`).toString("base64")}`, "Content-Type": "application/x-www-form-urlencoded" },
+    body: "grant_type=client_credentials",
+  });
+  if (!res.ok) throw new Error(`PayPal OAuth failed with HTTP ${res.status}`);
+  const data = (await res.json()) as { access_token: string; expires_in: number };
+  cached = { token: data.access_token, expiresAt: Date.now() + Math.max(0, data.expires_in - 60) * 1000 };
+  return data.access_token;
+}
+
+/**
+ * Verifies a webhook delivery with PayPal.
+ * @param headers the request headers
+ * @param rawBody the request body exactly as received, as text
+ */
+export async function verifyPayPalWebhook(headers: Headers, rawBody: string): Promise<WebhookVerification> {
+  const webhookId = process.env.PAYPAL_WEBHOOK_ID;
+  if (!webhookId) return { verified: false, reason: "PAYPAL_WEBHOOK_ID is not set" };
+  const values = HEADERS.map((h) => headers.get(h) ?? undefined);
+  if (values.some((v) => !v)) return { verified: false, reason: "missing PayPal transmission headers" };
+
+  let event: PayPalWebhookEvent;
+  try {
+    event = JSON.parse(rawBody) as PayPalWebhookEvent;
+  } catch {
+    return { verified: false, reason: "body is not JSON" };
+  }
+  if (!event || typeof event.event_type !== "string") return { verified: false, reason: "body is not a PayPal event" };
+
+  const [transmissionId, transmissionTime, transmissionSig, certUrl, authAlgo] = values as string[];
+  // Splice the raw body in as the event so PayPal sees the original bytes.
+  const body =
+    `{"auth_algo":${JSON.stringify(authAlgo)},"cert_url":${JSON.stringify(certUrl)},"transmission_id":${JSON.stringify(transmissionId)},` +
+    `"transmission_sig":${JSON.stringify(transmissionSig)},"transmission_time":${JSON.stringify(transmissionTime)},` +
+    `"webhook_id":${JSON.stringify(webhookId)},"webhook_event":${rawBody}}`;
+
+  const res = await fetchWithRetry(`${paypalApiBase()}/v1/notifications/verify-webhook-signature`, {
+    method: "POST",
+    headers: { Authorization: `Bearer ${await paypalAccessToken()}`, "Content-Type": "application/json", "PayPal-Request-Id": randomUUID() },
+    body,
+  });
+  if (!res.ok) {
+    const err = (await res.json().catch(() => ({}))) as { name?: string; details?: { field?: string; issue?: string }[] };
+    const d = err.details?.[0];
+    return {
+      verified: false,
+      reason: `verification call failed with HTTP ${res.status}${d ? `: ${d.field ?? ""} ${d.issue ?? ""}`.trimEnd() : err.name ? `: ${err.name}` : ""}`,
+    };
+  }
+  const result = (await res.json()) as { verification_status?: string };
+  return result.verification_status === "SUCCESS"
+    ? { verified: true, event }
+    : { verified: false, reason: `verification_status ${result.verification_status ?? "missing"}` };
+}
+
+/** For PAYMENT.CAPTURE.REFUNDED: the refund's resource links "up" to the capture it refunds. */
+export function capturedPaymentIdOfRefund(event: PayPalWebhookEvent): string | undefined {
+  const up = event.resource.links?.find((l) => l.rel === "up" && /\/captures\//.test(l.href));
+  return up ? up.href.split("/captures/")[1]?.split(/[/?]/)[0] : undefined;
+}
diff --git a/lib/paypal.ts b/lib/paypal.ts
new file mode 100644
index 0000000..91ed7ca
--- /dev/null
+++ b/lib/paypal.ts
@@ -0,0 +1,62 @@
+import { randomUUID } from "node:crypto";
+import { ApiError, Client, CustomError, Environment, OrdersController, PaymentsController } from "@paypal/paypal-server-sdk";
+
+// One shared PayPal Server SDK client, next to lib/stripe.ts. Sandbox unless PAYPAL_ENVIRONMENT is explicitly "live".
+export const paypalEnvironment: "sandbox" | "live" = process.env.PAYPAL_ENVIRONMENT === "live" ? "live" : "sandbox";
+
+let client: Client | undefined;
+
+/** Created on first use, so importing this module during a build (when PayPal settings may be absent) doesn't throw. */
+export function paypalClient(): Client {
+  if (client) return client;
+  const oAuthClientId = process.env.PAYPAL_CLIENT_ID;
+  const oAuthClientSecret = process.env.PAYPAL_CLIENT_SECRET;
+  if (!oAuthClientId || !oAuthClientSecret) {
+    throw new Error("PayPal is not configured: set PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET");
+  }
+  client = new Client({
+    clientCredentialsAuthCredentials: { oAuthClientId, oAuthClientSecret },
+    environment: paypalEnvironment === "live" ? Environment.Production : Environment.Sandbox,
+    timeout: 15_000,
+    httpClientOptions: {
+      // Retry dropped connections, 429s and 5xx. POST is safe to retry because every POST sends a PayPal-Request-Id.
+      retryConfig: {
+        maxNumberOfRetries: 2,
+        retryOnTimeout: true,
+        maximumRetryWaitTime: 10,
+        httpMethodsToRetry: ["GET", "PUT", "POST", "PATCH"],
+      },
+    },
+    // No `logging` option on purpose: it would log every request and response, payer details included.
+  });
+  return client;
+}
+
+export const ordersApi = (): OrdersController => new OrdersController(paypalClient());
+export const paymentsApi = (): PaymentsController => new PaymentsController(paypalClient());
+
+/** A fresh PayPal-Request-Id. Reuse the same value when retrying the same request. */
+export const paypalRequestId = (): string => randomUUID();
+
+/** A log-safe description of a PayPal error, including PayPal's debug_id. */
+export function describePayPalError(err: unknown): string {
+  if (err instanceof ApiError) {
+    const r = (err instanceof CustomError ? err.result : undefined) as
+      | { name?: string; message?: string; debug_id?: string; details?: { issue?: string }[] }
+      | undefined;
+    const debugId =
+      r?.debug_id ??
+      err.headers?.["paypal-debug-id"] ??
+      (typeof err.body === "string" ? /"debug_id"\s*:\s*"([^"]+)"/.exec(err.body)?.[1] : undefined);
+    const issue = r?.details?.[0]?.issue;
+    const detail = [r?.name, issue ?? r?.message, debugId ? `debug_id ${debugId}` : ""].filter(Boolean).join(" · ");
+    return `PayPal API error ${err.statusCode}${detail ? `: ${detail}` : ""}`;
+  }
+  return err instanceof Error ? err.message : String(err);
+}
+
+/** PayPal's issue code (for example ORDER_ALREADY_CAPTURED), when the error carries one. */
+export function paypalIssue(err: unknown): string | undefined {
+  if (!(err instanceof CustomError)) return undefined;
+  return (err.result as { details?: { issue?: string }[] } | undefined)?.details?.[0]?.issue;
+}
