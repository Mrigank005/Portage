diff --git a/app/api/paypal/orders/[orderId]/capture/route.ts b/app/api/paypal/orders/[orderId]/capture/route.ts
new file mode 100644
index 0000000..e83069e
--- /dev/null
+++ b/app/api/paypal/orders/[orderId]/capture/route.ts
@@ -0,0 +1,80 @@
+import { NextResponse } from "next/server";
+import { CaptureStatus, OrderStatus, type Order as PayPalOrder } from "@paypal/paypal-server-sdk";
+import { describePayPalError, ordersApi, paypalIssue } from "@/lib/paypal";
+import { fromPayPalMoney } from "@/lib/paypal-money";
+import { findOrderByPayPalOrderId, updateOrder } from "@/lib/orders";
+import { fulfillOrder } from "@/lib/fulfilment";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+// Captures a PayPal order the buyer approved, then fulfils it with the same code the Stripe webhook uses.
+export async function POST(request: Request, { params }: { params: Promise<{ orderId: string }> }) {
+  const { orderId: paypalOrderId } = await params;
+  const order = findOrderByPayPalOrderId(paypalOrderId);
+  if (!order) return NextResponse.json({ error: "Order not found" }, { status: 404 });
+
+  const origin = process.env.APP_URL ?? new URL(request.url).origin;
+  const redirectUrl = `${origin}/order/${order.id}`;
+  if (order.status !== "pending") return NextResponse.json({ redirectUrl }); // already captured (webhook or a retry)
+
+  let paypalOrder: PayPalOrder;
+  try {
+    const { result } = await ordersApi().captureOrder({
+      id: paypalOrderId,
+      // One capture per order: a retried request returns the first result instead of failing or charging twice.
+      paypalRequestId: `capture-${paypalOrderId}`,
+      prefer: "return=representation",
+    });
+    paypalOrder = result;
+  } catch (err) {
+    if (paypalIssue(err) !== "ORDER_ALREADY_CAPTURED") {
+      console.error(`PayPal captureOrder failed for ${order.id}: ${describePayPalError(err)}`);
+      const declined = paypalIssue(err) === "INSTRUMENT_DECLINED";
+      return NextResponse.json(
+        { error: declined ? "PayPal declined that payment method. Please choose another one." : "The payment could not be completed. You have not been charged." },
+        { status: declined ? 402 : 502 },
+      );
+    }
+    try {
+      paypalOrder = (await ordersApi().getOrder({ id: paypalOrderId })).result;
+    } catch (lookupErr) {
+      console.error(`PayPal getOrder failed for ${order.id}: ${describePayPalError(lookupErr)}`);
+      return NextResponse.json({ error: "The payment could not be confirmed. Please contact us." }, { status: 502 });
+    }
+  }
+
+  const unit = paypalOrder.purchaseUnits?.[0];
+  const capture = unit?.payments?.captures?.[0];
+  if (!capture?.id) {
+    console.error(`PayPal order ${paypalOrderId} for ${order.id} has no capture (status ${paypalOrder.status})`);
+    return NextResponse.json({ error: "The payment could not be completed. You have not been charged." }, { status: 502 });
+  }
+
+  // Only what PayPal captured counts: the right order, the right amount and currency.
+  let capturedAmount = -1;
+  try {
+    capturedAmount = capture.amount ? fromPayPalMoney(capture.amount) : -1;
+  } catch {
+    /* treated as a mismatch below */
+  }
+  const sameCurrency = capture.amount?.currencyCode?.toLowerCase() === order.currency.toLowerCase();
+  if (unit?.customId !== order.id || !sameCurrency || capturedAmount !== order.total) {
+    console.error(`PayPal capture ${capture.id} does not match ${order.id} (amount or reference differs)`);
+    updateOrder(order.id, { paypalCaptureId: capture.id });
+    return NextResponse.json({ error: "The payment did not match your order. Please contact us." }, { status: 409 });
+  }
+
+  const email = paypalOrder.paymentSource?.paypal?.emailAddress ?? null;
+  if (paypalOrder.status === OrderStatus.Completed && capture.status === CaptureStatus.Completed) {
+    fulfillOrder(order.id, { provider: "paypal", paypalOrderId, paypalCaptureId: capture.id, email });
+    return NextResponse.json({ redirectUrl });
+  }
+  if (capture.status === CaptureStatus.Pending) {
+    // PayPal is still reviewing it. The order page waits; PAYMENT.CAPTURE.COMPLETED fulfils it later.
+    updateOrder(order.id, { paypalCaptureId: capture.id, email });
+    return NextResponse.json({ redirectUrl });
+  }
+  updateOrder(order.id, { status: "failed", paypalCaptureId: capture.id });
+  return NextResponse.json({ error: "PayPal declined that payment. You have not been charged." }, { status: 402 });
+}
diff --git a/app/api/paypal/orders/route.ts b/app/api/paypal/orders/route.ts
new file mode 100644
index 0000000..658afa0
--- /dev/null
+++ b/app/api/paypal/orders/route.ts
@@ -0,0 +1,78 @@
+import { NextResponse } from "next/server";
+import { CheckoutPaymentIntent, PaypalExperienceUserAction, PaypalWalletContextShippingPreference } from "@paypal/paypal-server-sdk";
+import { describePayPalError, ordersApi } from "@/lib/paypal";
+import { paypalSupportsCurrency, toPayPalMoney } from "@/lib/paypal-money";
+import { findByPriceId } from "@/lib/catalog";
+import { createOrder, updateOrder } from "@/lib/orders";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+// Starts a PayPal payment. The PayPal buttons send the product form's fields (priceId, quantity); never an amount.
+export async function POST(request: Request) {
+  const fields = (await request.json().catch(() => ({}))) as Record<string, unknown>;
+  const priceId = String(fields.priceId ?? "");
+  const quantity = Math.min(Math.max(parseInt(String(fields.quantity ?? "1"), 10) || 1, 1), 10);
+  if (!priceId) return NextResponse.json({ error: "priceId is required" }, { status: 400 });
+
+  // Never trust a price sent by the browser: read it from the shop's catalog.
+  const product = findByPriceId(priceId);
+  if (!product) return NextResponse.json({ error: "That product is not available" }, { status: 400 });
+  const { unitAmount, currency } = product.price;
+  if (!paypalSupportsCurrency(currency)) {
+    return NextResponse.json({ error: "That product can't be paid for with PayPal" }, { status: 400 });
+  }
+
+  const order = createOrder({
+    items: [{ priceId, name: product.name, quantity, unitAmount }],
+    currency,
+    paymentProvider: "paypal",
+  });
+
+  // Every amount goes through the money helper: it refuses amounts PayPal can't represent instead of rounding.
+  let unit, total;
+  try {
+    unit = toPayPalMoney(unitAmount, currency);
+    total = toPayPalMoney(order.total, currency);
+  } catch (err) {
+    updateOrder(order.id, { status: "failed" });
+    console.error(`PayPal order for ${order.id} refused: ${(err as Error).message}`);
+    return NextResponse.json({ error: "That product can't be paid for with PayPal" }, { status: 400 });
+  }
+
+  const origin = process.env.APP_URL ?? new URL(request.url).origin;
+  try {
+    const { result } = await ordersApi().createOrder({
+      // Same order, same request: a retried request returns the original PayPal order instead of creating another.
+      paypalRequestId: `create-${order.id}`,
+      body: {
+        intent: CheckoutPaymentIntent.Capture,
+        purchaseUnits: [
+          {
+            referenceId: order.id,
+            customId: order.id,
+            amount: { ...total, breakdown: { itemTotal: total } },
+            items: [{ name: product.name, unitAmount: unit, quantity: String(quantity), sku: product.paypalProductId }],
+          },
+        ],
+        paymentSource: {
+          paypal: {
+            experienceContext: {
+              shippingPreference: PaypalWalletContextShippingPreference.NoShipping,
+              userAction: PaypalExperienceUserAction.PayNow,
+              returnUrl: `${origin}/order/${order.id}`,
+              cancelUrl: `${origin}/`,
+            },
+          },
+        },
+      },
+    });
+    if (!result.id) throw new Error("PayPal returned no order ID");
+    updateOrder(order.id, { paypalOrderId: result.id });
+    return NextResponse.json({ orderId: result.id });
+  } catch (err) {
+    updateOrder(order.id, { status: "failed" });
+    console.error(`PayPal createOrder failed for ${order.id}: ${describePayPalError(err)}`);
+    return NextResponse.json({ error: "PayPal checkout is unavailable right now. Please try again." }, { status: 502 });
+  }
+}
diff --git a/app/api/webhooks/paypal/route.ts b/app/api/webhooks/paypal/route.ts
new file mode 100644
index 0000000..6f17fcd
--- /dev/null
+++ b/app/api/webhooks/paypal/route.ts
@@ -0,0 +1,99 @@
+import { NextResponse } from "next/server";
+import { capturedPaymentIdOfRefund, verifyPayPalWebhook, type PayPalWebhookEvent } from "@/lib/paypal-webhook";
+import { describePayPalError, ordersApi } from "@/lib/paypal";
+import { fromPayPalMoney } from "@/lib/paypal-money";
+import { findOrderByPayPalCaptureId, findOrderByPayPalOrderId, getOrder, updateOrder, type Order } from "@/lib/orders";
+import { fulfillOrder, recordRefund } from "@/lib/fulfilment";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function POST(request: Request) {
+  // PayPal checks the signature over the exact bytes it sent, so read the body as text and pass it on unchanged.
+  const payload = await request.text();
+  let verification;
+  try {
+    verification = await verifyPayPalWebhook(request.headers, payload);
+  } catch (err) {
+    // PayPal couldn't be asked: answer 5xx so PayPal delivers the event again later.
+    console.error(`PayPal webhook verification unavailable: ${(err as Error).message}`);
+    return new Response("Webhook verification unavailable", { status: 503 });
+  }
+  if (!verification.verified) {
+    console.warn(`PayPal webhook rejected: ${verification.reason}`);
+    return new Response("Webhook signature verification failed", { status: 400 });
+  }
+  const event = verification.event;
+
+  switch (event.event_type) {
+    case "PAYMENT.CAPTURE.COMPLETED":
+      await captureCompleted(event);
+      break;
+    case "PAYMENT.CAPTURE.REFUNDED":
+      captureRefunded(event);
+      break;
+    case "PAYMENT.CAPTURE.DENIED": {
+      // A capture that came back PENDING was declined after review: the order was never paid.
+      const order = event.resource.id ? findOrderByPayPalCaptureId(event.resource.id) : undefined;
+      if (order?.status === "pending") updateOrder(order.id, { status: "failed" });
+      break;
+    }
+    default:
+      // Other events are acknowledged and ignored.
+      break;
+  }
+
+  return NextResponse.json({ received: true });
+}
+
+async function captureCompleted(event: PayPalWebhookEvent) {
+  const capture = event.resource;
+  const paypalOrderId = capture.supplementary_data?.related_ids?.order_id;
+  if (!capture.id || capture.status !== "COMPLETED" || !paypalOrderId) return;
+
+  const order: Order | undefined =
+    (capture.custom_id ? getOrder(capture.custom_id) : undefined) ?? findOrderByPayPalOrderId(paypalOrderId) ?? findOrderByPayPalCaptureId(capture.id);
+  if (!order || order.paypalOrderId !== paypalOrderId) return;
+
+  // Fulfil only for the amount the shop asked for.
+  let amount = -1;
+  try {
+    amount = capture.amount ? fromPayPalMoney(capture.amount) : -1;
+  } catch {
+    /* mismatch */
+  }
+  if (amount !== order.total || capture.amount?.currency_code?.toLowerCase() !== order.currency.toLowerCase()) {
+    console.error(`PayPal capture ${capture.id} does not match ${order.id}; not fulfilling`);
+    return;
+  }
+
+  // The capture event doesn't carry the payer; ask PayPal for the order so the receipt has an address.
+  let email: string | null = null;
+  if (order.status === "pending" || !order.email) {
+    try {
+      email = (await ordersApi().getOrder({ id: paypalOrderId })).result.paymentSource?.paypal?.emailAddress ?? null;
+    } catch (err) {
+      console.warn(`PayPal getOrder failed for ${order.id}: ${describePayPalError(err)}`);
+    }
+  }
+  fulfillOrder(order.id, { provider: "paypal", paypalOrderId, paypalCaptureId: capture.id, email });
+}
+
+function captureRefunded(event: PayPalWebhookEvent) {
+  const captureId = capturedPaymentIdOfRefund(event);
+  if (!captureId) return;
+  const order = findOrderByPayPalCaptureId(captureId);
+  if (!order) return;
+
+  // resource.amount is only this refund; total_refunded_amount is the running total for the capture.
+  const total = event.resource.seller_payable_breakdown?.total_refunded_amount ?? event.resource.amount;
+  if (!total) return;
+  let refunded: number;
+  try {
+    refunded = fromPayPalMoney(total);
+  } catch {
+    console.error(`PayPal refund for ${order.id} has an unreadable amount`);
+    return;
+  }
+  recordRefund(captureId, refunded, refunded >= order.total);
+}
