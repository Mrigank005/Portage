@@ -0,0 +1,62 @@
+import { NextResponse } from "next/server";
+import { findOrderByPayPalCapture, findOrderByPayPalOrderId, getOrder } from "@/lib/orders";
+import { fulfillOrder, recordOrderRefund } from "@/lib/fulfilment";
+import { describePayPalError, ordersApi } from "@/lib/paypal";
+import { fromPayPalMoney } from "@/lib/paypal-money";
+import { capturedPaymentIdOfRefund, verifyPayPalWebhook } from "@/lib/paypal-webhook";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+// PayPal's counterpart of /api/webhooks/stripe. Every branch is idempotent: PayPal retries deliveries, and the capture
+// route may already have recorded the same payment.
+export async function POST(request: Request) {
+  // Verification needs the exact bytes PayPal sent, so read the body as text.
+  const payload = await request.text();
+  const check = await verifyPayPalWebhook(request.headers, payload);
+  if (!check.verified) {
+    console.warn("[brewbox] PayPal webhook rejected:", check.reason);
+    return new Response("Webhook verification failed", { status: 400 });
+  }
+  const event = check.event;
+  const resource = event.resource;
+
+  switch (event.event_type) {
+    case "PAYMENT.CAPTURE.COMPLETED": {
+      // Was checkout.session.completed: the payment went through.
+      const paypalOrderId = resource.supplementary_data?.related_ids?.order_id;
+      const order = (resource.custom_id ? getOrder(resource.custom_id) : undefined) ?? (paypalOrderId ? findOrderByPayPalOrderId(paypalOrderId) : undefined);
+      if (!order || order.status !== "pending" || !resource.id || !resource.amount) break;
+      if (fromPayPalMoney(resource.amount) !== order.total || resource.amount.currency_code !== order.currency.toUpperCase()) {
+        console.error(`[brewbox] PayPal capture ${resource.id} amount does not match order ${order.id}; not fulfilling`);
+        break;
+      }
+      let email: string | null = null;
+      const id = paypalOrderId ?? order.paypalOrderId;
+      if (id) {
+        try {
+          email = (await ordersApi().getOrder({ id })).result.paymentSource?.paypal?.emailAddress ?? null;
+        } catch (err) {
+          console.warn("[brewbox] could not read the PayPal order for the receipt email:", describePayPalError(err));
+        }
+      }
+      fulfillOrder(order.id, { provider: "paypal", paypalOrderId: id ?? "", paypalCaptureId: resource.id, email });
+      break;
+    }
+    case "PAYMENT.CAPTURE.REFUNDED": {
+      // Was charge.refunded. The resource is the refund; total_refunded_amount is the running total, like Stripe's amount_refunded.
+      const captureId = capturedPaymentIdOfRefund(event);
+      const order = captureId ? findOrderByPayPalCapture(captureId) : undefined;
+      const total = resource.seller_payable_breakdown?.total_refunded_amount;
+      if (order && total) {
+        const refunded = fromPayPalMoney(total);
+        recordOrderRefund(order.id, refunded, refunded >= order.total);
+      }
+      break;
+    }
+    default:
+      // Other events are acknowledged and ignored.
+      break;
+  }
+  return NextResponse.json({ received: true });
+}
