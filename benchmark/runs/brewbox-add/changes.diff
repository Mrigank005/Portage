@@ -0,0 +1,55 @@
+import { NextResponse } from "next/server";
+import { ApiError, CaptureStatus, CustomError, OrderStatus } from "@paypal/paypal-server-sdk";
+import { findOrderByPayPalOrderId } from "@/lib/orders";
+import { fulfillOrder } from "@/lib/fulfilment";
+import { describePayPalError, ordersApi } from "@/lib/paypal";
+import { fromPayPalMoney } from "@/lib/paypal-money";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+// Captures a PayPal order after the buyer approves it, then fulfils it with the same code the Stripe webhook uses.
+// Answers { redirectUrl } (the order page Stripe's success_url also leads to) or { error }.
+export async function POST(request: Request, { params }: { params: Promise<{ orderId: string }> }) {
+  const { orderId } = await params;
+  const order = findOrderByPayPalOrderId(orderId);
+  if (!order) return NextResponse.json({ error: "Unknown order" }, { status: 404 });
+
+  const origin = process.env.APP_URL ?? new URL(request.url).origin;
+  const redirectUrl = `${origin}/order/${order.id}`;
+  if (order.status !== "pending") return NextResponse.json({ redirectUrl }); // already captured (a retry or the webhook got there first)
+
+  let captured;
+  try {
+    // The same request id for the same order, so a retried capture can never charge twice.
+    ({ result: captured } = await ordersApi().captureOrder({ id: orderId, paypalRequestId: `brewbox-capture-${orderId}` }));
+  } catch (err) {
+    const issue = err instanceof CustomError ? (err.result as { details?: { issue?: string }[] } | undefined)?.details?.[0]?.issue : undefined;
+    console.error("[brewbox] PayPal capture failed:", describePayPalError(err));
+    if (issue === "INSTRUMENT_DECLINED") {
+      return NextResponse.json({ error: "PayPal declined that payment method. Please try again and choose another one." }, { status: 422 });
+    }
+    const status = err instanceof ApiError && err.statusCode < 500 ? 422 : 502;
+    return NextResponse.json({ error: "The payment could not be completed. You have not been charged." }, { status });
+  }
+
+  const capture = captured.purchaseUnits?.[0]?.payments?.captures?.[0];
+  if (capture?.status === CaptureStatus.Pending) return NextResponse.json({ redirectUrl }); // PayPal will confirm it with a webhook
+  if (captured.status !== OrderStatus.Completed || capture?.status !== CaptureStatus.Completed || !capture.id || !capture.amount) {
+    return NextResponse.json({ error: "The payment could not be completed. You have not been charged." }, { status: 402 });
+  }
+
+  // Only fulfil what was actually paid: the captured amount must match the order exactly.
+  if (fromPayPalMoney(capture.amount) !== order.total || capture.amount.currencyCode !== order.currency.toUpperCase()) {
+    console.error(`[brewbox] PayPal capture ${capture.id} amount does not match order ${order.id}; not fulfilling`);
+    return NextResponse.json({ error: "The payment amount did not match the order. Please contact us." }, { status: 409 });
+  }
+
+  fulfillOrder(order.id, {
+    provider: "paypal",
+    paypalOrderId: orderId,
+    paypalCaptureId: capture.id,
+    email: captured.paymentSource?.paypal?.emailAddress ?? null,
+  });
+  return NextResponse.json({ redirectUrl });
+}
diff --git a/app/api/paypal/orders/route.ts b/app/api/paypal/orders/route.ts
new file mode 100644
index 0000000..462b412
--- /dev/null
+++ b/app/api/paypal/orders/route.ts
@@ -0,0 +1,83 @@
+import { NextResponse } from "next/server";
+import type Stripe from "stripe";
+import { CheckoutPaymentIntent, PaypalExperienceUserAction, PaypalWalletContextShippingPreference } from "@paypal/paypal-server-sdk";
+import { stripe } from "@/lib/stripe";
+import { createOrder, updateOrder } from "@/lib/orders";
+import { describePayPalError, ordersApi, paypalRequestId } from "@/lib/paypal";
+import { toPayPalMoney } from "@/lib/paypal-money";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+// Creates a PayPal order for the PayPal button. Mirrors POST /api/checkout: same validation, same prices (read from
+// Stripe, never from the browser), same order record. Answers { orderId } for the button.
+export async function POST(request: Request) {
+  const body = (await request.json().catch(() => ({}))) as { priceId?: unknown; quantity?: unknown };
+  const priceId = String(body.priceId ?? "");
+  const quantity = Math.min(Math.max(parseInt(String(body.quantity ?? "1"), 10) || 1, 1), 10);
+  if (!priceId) return NextResponse.json({ error: "priceId is required" }, { status: 400 });
+
+  let price: Stripe.Price;
+  try {
+    price = await stripe.prices.retrieve(priceId, { expand: ["product"] });
+  } catch {
+    return NextResponse.json({ error: "That product is not available" }, { status: 400 });
+  }
+  if (!price.active || price.unit_amount === null) {
+    return NextResponse.json({ error: "That product is not available" }, { status: 400 });
+  }
+  const product = price.product as Stripe.Product;
+
+  let unitAmount: ReturnType<typeof toPayPalMoney>;
+  let total: ReturnType<typeof toPayPalMoney>;
+  try {
+    unitAmount = toPayPalMoney(price.unit_amount, price.currency);
+    total = toPayPalMoney(price.unit_amount * quantity, price.currency);
+  } catch {
+    return NextResponse.json({ error: "This product can't be paid with PayPal. Please pay by card." }, { status: 400 });
+  }
+
+  const origin = process.env.APP_URL ?? new URL(request.url).origin;
+  const order = createOrder({
+    items: [{ priceId, name: product.name, quantity, unitAmount: price.unit_amount }],
+    currency: price.currency,
+    paymentProvider: "paypal",
+  });
+
+  try {
+    const { result } = await ordersApi().createOrder({
+      body: {
+        intent: CheckoutPaymentIntent.Capture,
+        purchaseUnits: [
+          {
+            customId: order.id,
+            amount: { ...total, breakdown: { itemTotal: total } },
+            items: [{ name: product.name.slice(0, 127), quantity: String(quantity), unitAmount, sku: price.id }],
+          },
+        ],
+        paymentSource: {
+          paypal: {
+            experienceContext: {
+              brandName: "Brewbox",
+              // Required whenever an experience context is sent: without them PayPal shows an error page after
+              // the buyer logs in. Same pages as the Stripe session's success_url and cancel_url.
+              returnUrl: `${origin}/order/${order.id}`,
+              cancelUrl: `${origin}/`,
+              // The Stripe checkout doesn't collect an address, so neither does PayPal.
+              shippingPreference: PaypalWalletContextShippingPreference.NoShipping,
+              userAction: PaypalExperienceUserAction.PayNow,
+            },
+          },
+        },
+      },
+      paypalRequestId: paypalRequestId(),
+    });
+    if (!result.id) throw new Error("PayPal returned no order ID");
+    updateOrder(order.id, { paypalOrderId: result.id });
+    return NextResponse.json({ orderId: result.id });
+  } catch (err) {
+    console.error("[brewbox] could not create a PayPal order:", describePayPalError(err));
+    updateOrder(order.id, { status: "failed" });
+    return NextResponse.json({ error: "PayPal checkout is unavailable right now. Please try again." }, { status: 502 });
+  }
+}
