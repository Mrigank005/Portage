---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page doesn't exist.">
  <div class="page-hero" style="border-bottom:0">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 class="display-xl">This page doesn't exist.</h1>
      <p class="lead">It may have moved. These will get you back on track.</p>
      <p style="margin-top:28px;display:flex;flex-wrap:wrap;gap:12px"><a class="btn btn-primary" href="/">Home</a><a class="btn btn-ghost" href="/docs">Quickstart</a><a class="btn btn-ghost" href="/runs">Runs</a></p>
    </div>
  </div>
</Base>
