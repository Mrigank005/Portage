{
  "mcpServers": {
    "context-matic": {
      "type": "http",
      "url": "https://chatbotapi.apimatic.io/mcp/plugins",
      "headers": {
        "X-Apimatic-Mcp-Client": "Cursor"
      }
    },
    "portage": {
      "command": "node",
      "args": [
        "--import",
        "tsx",
        "${workspaceFolder}/packages/mcp-server/src/index.ts"
      ],
      "cwd": "${workspaceFolder}"
    }
  }
}
