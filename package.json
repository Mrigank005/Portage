{
  "name": "portage-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Portage: adds PayPal to apps that use Stripe, and proves it with a real PayPal sandbox payment.",
  "workspaces": [
    "packages/standin",
    "packages/core",
    "packages/mcp-server",
    "packages/cli",
    "apps/webhook-relay",
    "suite/brewbox-store",
    "suite/quill-saas"
  ],
  "scripts": {
    "standin": "tsx packages/standin/src/cli.ts --config suite/standin.config.json",
    "test": "npm test -w packages/standin -w packages/core -w packages/mcp-server -w apps/webhook-relay",
    "suite:e2e": "node scripts/suite-e2e.mjs",
    "setup:check": "node --env-file=.env scripts/check-setup.mjs",
    "benchmark:real": "node --import tsx scripts/scan-real-repos.mts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:plugin": "npm run build -w packages/mcp-server",
    "portage": "portage",
    "reference:embed": "node scripts/embed-reference.mjs",
    "skill:sync": "node --import tsx scripts/sync-skill.mts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "^11.0.6"
    }
  }
}
