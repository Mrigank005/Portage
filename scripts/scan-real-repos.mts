// Runs Portage's scan and plan on real open-source Stripe apps and writes the results to benchmark/real-repos/.
// The repositories are cloned into .cache/real-repos (not committed) and are only parsed, never installed or run.
//
//   npm run benchmark:real            clone (or reuse) each repo at its pinned commit, scan, plan, write results
//   npm run benchmark:real -- --pin   also record each repo's current commit in repos.json
import { execFileSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { planMigration, renderPlan, renderScan, scanRepo, type ScanResult } from "../packages/core/src/index.ts";

interface Repo {
  name: string;
  repo: string;
  subdir?: string;
  commit?: string;
  why: string;
}

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const outDir = path.join(root, "benchmark", "real-repos");
const cacheDir = path.join(root, ".cache", "real-repos");
const listFile = path.join(outDir, "repos.json");
const repos = JSON.parse(fs.readFileSync(listFile, "utf8")) as Repo[];
const pin = process.argv.includes("--pin");

const git = (cwd: string, ...args: string[]) => execFileSync("git", args, { cwd, stdio: ["ignore", "pipe", "pipe"], encoding: "utf8" }).trim();

function checkout(r: Repo): { dir: string; commit: string } {
  const dir = path.join(cacheDir, r.name);
  if (!fs.existsSync(path.join(dir, ".git"))) {
    fs.mkdirSync(dir, { recursive: true });
    git(dir, "init", "-q");
    git(dir, "remote", "add", "origin", r.repo);
    if (r.subdir) {
      git(dir, "config", "core.sparseCheckout", "true");
      fs.writeFileSync(path.join(dir, ".git", "info", "sparse-checkout"), `/${r.subdir}/\n`);
    }
  }
  const ref = r.commit ?? "HEAD";
  console.log(`  fetching ${r.repo} at ${ref}`);
  git(dir, "fetch", "-q", "--depth", "1", "--filter=blob:none", "origin", ref);
  git(dir, "checkout", "-q", "--force", "FETCH_HEAD");
  return { dir: r.subdir ? path.join(dir, r.subdir) : dir, commit: git(dir, "rev-parse", "HEAD") };
}

/** Results are published, so replace the local clone path with the public repository URL. */
function publicScan(scan: ScanResult, r: Repo, commit: string): ScanResult {
  return { ...scan, repo: { path: `${r.repo}/tree/${commit}${r.subdir ? `/${r.subdir}` : ""}`, name: r.name } };
}

const rows: string[] = [];
for (const r of repos) {
  console.log(`${r.name}`);
  const { dir, commit } = checkout(r);
  if (pin) r.commit = commit;
  const scan = publicScan(scanRepo(dir), r, commit);
  scan.stats.ms = 0; // published files must be identical from run to run
  const plan = planMigration(scan);
  const target = path.join(outDir, r.name);
  fs.mkdirSync(target, { recursive: true });
  const source = `Source: ${r.repo}${r.subdir ? ` (${r.subdir})` : ""} at commit \`${commit}\`. ${r.why}\n\n`;
  fs.writeFileSync(path.join(target, "scan.md"), `${source}${renderScan(scan)}\n`);
  fs.writeFileSync(path.join(target, "plan.md"), `${source}${renderPlan(plan)}\n`);
  fs.writeFileSync(path.join(target, "scan.json"), `${JSON.stringify(scan, null, 2)}\n`);

  const live = scan.apps.flatMap((a) => a.calls.filter((c) => !c.inTest));
  const blocker = [...scan.issues, ...scan.apps.flatMap((a) => a.issues)].find((i) => i.severity === "blocker");
  const app = scan.apps.find((a) => a.supported) ?? scan.apps[0];
  const result = scan.supported ? `Planned: ${plan.headline}` : `Refused (${blocker?.code}): ${blocker?.message}`;
  rows.push(
    `| [${r.name}](${r.repo}${r.subdir ? `/tree/${commit}/${r.subdir}` : ""}) | \`${commit.slice(0, 7)}\` | ${app ? `${app.framework.label}${scan.apps.length > 1 ? ` (+${scan.apps.length - 1} more apps)` : ""}` : "no Node.js app"} | ${live.length} | ${result.replace(/\|/g, "\\|")} | [scan](${r.name}/scan.md) · [plan](${r.name}/plan.md) |`,
  );
  console.log(`  ${result}`);
}

if (pin) fs.writeFileSync(listFile, `${JSON.stringify(repos, null, 2)}\n`);

fs.writeFileSync(
  path.join(outDir, "README.md"),
  `# Portage on real open-source Stripe apps

Portage's test suite runs on Standin, a local Stripe-compatible server, because Stripe accounts are invite-only in India where Portage is built. To show the scanner and planner on code we didn't write, we also run them on public open-source apps that use Stripe. These results are generated by \`npm run benchmark:real\` at the commits below; the repositories are only parsed, never installed or run.

| Repository | Commit | Framework | Stripe calls | Result | Details |
|---|---|---|---|---|---|
${rows.join("\n")}

"Refused" is a correct outcome when the app is outside Portage's scope (for example, subscription-only billing): Portage says why and changes nothing. Scan and plan only read code; the PayPal changes and the sandbox payment test happen later in the workflow.
`,
);
console.log(`Wrote ${path.relative(root, outDir)}`);
