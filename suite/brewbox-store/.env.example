# Brewbox settings. Copy to .env.local.
# The suite runs against Standin (a local Stripe-compatible server). To use real Stripe instead,
# delete STRIPE_API_BASE and put your own Stripe test keys below.
STRIPE_API_BASE=http://localhost:4242
STRIPE_SECRET_KEY=sk_test_standin_brewbox
STRIPE_WEBHOOK_SECRET=whsec_standin
APP_URL=http://localhost:4300
