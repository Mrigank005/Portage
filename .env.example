# Copy to .env and fill in. Never commit .env.

# --- PayPal sandbox ---
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID, PORTAGE_RELAY_URL and PORTAGE_RELAY_CHANNEL are written by `npx portage relay setup <app>`
# (or the setup_webhook_relay tool). The channel is private: anyone with it can read that app's sandbox webhooks.
PAYPAL_WEBHOOK_ID=
PORTAGE_RELAY_URL=https://portage-relay.onrender.com
PORTAGE_RELAY_CHANNEL=

# --- PayPal sandbox logins (used by the automated checkout test, verify_checkout) ---
# Use a US sandbox personal account as the buyer: the default sandbox buyer can get
# "This seller doesn't accept payments in your currency". PAYPAL_SANDBOX_US_BUYER_* is used first if set.
PAYPAL_SANDBOX_BUSINESS_EMAIL=
PAYPAL_SANDBOX_BUSINESS_PASSWORD=
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# --- Stripe side ---
# The test suite runs against Standin, a local Stripe-compatible server, so these
# defaults work without a Stripe account. For a real repo, remove STRIPE_API_BASE
# and use that project's own Stripe TEST keys (sk_test_..., pk_test_...).
STRIPE_API_BASE=http://localhost:4242
STRIPE_SECRET_KEY=sk_test_standin
STRIPE_PUBLISHABLE_KEY=pk_test_standin
STRIPE_WEBHOOK_SECRET=whsec_standin

# --- GitHub (optional) ---
GITHUB_OWNER=
GITHUB_TOKEN=
